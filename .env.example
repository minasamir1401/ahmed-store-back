# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mithaly

# ─── Application ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production
JWT_SECRET=CHANGE_ME_to_a_random_64_char_string

# ─── Admin Initialization (only needed on first run) ──────────
# Must be at least 12 characters. Remove after first login.
ADMIN_INIT_PASSWORD=CHANGE_ME_strong_password_min_12chars
ADMIN_INIT_EMAIL=admin@your-domain.com
ADMIN_INIT_PHONE=201000000000

# ─── OTP Security (separate from JWT) ────────────────────────
OTP_SECRET=CHANGE_ME_to_another_random_64_char_string

# ─── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── AI Providers (backend only — never expose to frontend) ───
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
APIFREE_API_KEY=apf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Google Indexing ──────────────────────────────────────────
GOOGLE_INDEXING_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# Store the private key as a single-line JSON string or reference a secret manager
GOOGLE_INDEXING_PRIVATE_KEY=

# ─── WhatsApp ─────────────────────────────────────────────────
WHATSAPP_AUTH_PATH=/tmp/.baileys_auth

# ─── Shipping (Aramex) ────────────────────────────────────────
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_PASSWORD=
ARAMEX_USERNAME=
ARAMEX_ACCOUNT_PIN=

# ─── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com
